# PostgreSQL connection string, e.g. from Vercel Postgres, Neon, or Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/schoolhub"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Paystack (subscription billing, School Admin > Billing)
# https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Create a "Pro" Plan per interval in the Paystack dashboard (currency GHS)
# and paste each Plan's plan code here. Amounts must match src/lib/paystack.ts.
PAYSTACK_PRO_MONTHLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PRO_QUARTERLY_PLAN_CODE="PLN_xxx"
PAYSTACK_PRO_ANNUALLY_PLAN_CODE="PLN_xxx"
