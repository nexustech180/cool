# PostgreSQL connection string, e.g. from Vercel Postgres, Neon, or Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/schoolhub"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Paystack secret key – get from https://dashboard.paystack.com/#/settings/developers
# Use sk_test_... for development / staging and sk_live_... for production.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret token used to authenticate Vercel Cron calls to /api/billing/renew.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-random-secret"
